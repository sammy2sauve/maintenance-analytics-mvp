# Database (Neon PostgreSQL)
DATABASE_URL=postgresql://...

# JWT signing — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# AES master key for MaintainX API key encryption — generate with: python -c "import secrets; print(secrets.token_hex(16))"
TRUESIGNAL_MASTER_KEY=

# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM=support@truesignalapp.com

# App URL — set to your live frontend URL in production
APP_URL=https://truesignalapp.com
